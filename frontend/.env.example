AUTH_SECRET=
API_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sentry (RNF-OBS-04). Sin DSN, Sentry.init trata el valor vacío como "desactivado": no hace falta
# completarlo en desarrollo. NEXT_PUBLIC_SENTRY_DSN va al bundle del browser (instrumentation-client.ts);
# SENTRY_DSN es solo server/edge (instrumentation.ts). Normalmente el mismo valor en ambos.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
