NODE_ENV=development
# api | worker | all (all = processors dentro de la API, solo desarrollo)
APP_ROLE=all
PORT=3000
DATABASE_URL=postgresql://freecell:freecell@localhost:5432/freecell
DB_SSL=false
REDIS_URL=redis://localhost:6379/0
# Puertos que docker-compose.yml expone al host (solo building/leyendo este .env, no dentro de los
# contenedores). Si 5432/6379 ya los usa un Postgres/Redis nativo, descomenta y cambia:
# DB_PORT=5433
# REDIS_PORT=6380
# Mínimo 32 caracteres. Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=[genera-un-secreto-de-al-menos-32-caracteres]
JWT_REFRESH_PEPPER=[genera-otro-secreto-de-al-menos-32-caracteres]
# 32 bytes en base64. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LICENSE_ENC_KEY=[base64-de-32-bytes]
# Cloudflare R2 (S3-compatible, D48/D49). Credenciales en el dashboard de Cloudflare →
# R2 → "Manage R2 API Tokens". El bucket debe ser privado.
R2_ACCOUNT_ID=[id-de-cuenta-de-cloudflare]
R2_ACCESS_KEY_ID=[access-key-id-del-token-r2]
R2_SECRET_ACCESS_KEY=[secret-access-key-del-token-r2]
R2_BUCKET=[nombre-del-bucket-privado-de-comprobantes]
CORS_ORIGIN=http://localhost:3001
THROTTLE_ENABLED=true
LOG_LEVEL=info
# Solo para npm run seed
ADMIN_EMAIL=[correo-del-admin]
ADMIN_PASSWORD=[contraseña-de-al-menos-12-caracteres]

# Solo para `npm run test:e2e` (test/setup-env.ts). Si tienes un Postgres/Redis nativo ocupando
# los puertos por defecto (5432/6379), usa los puertos alternos que expone docker-compose.yml
# vía DB_PORT/REDIS_PORT (p. ej. DB_PORT=5433 REDIS_PORT=6380 en este mismo archivo) y apúntalos aquí:
# TEST_DATABASE_URL=postgresql://freecell:freecell@localhost:5433/licencias_test
# TEST_REDIS_URL=redis://localhost:6380/1
