# --- Servidor ---
PORT=3000
CORS_ORIGIN=http://localhost:3001

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://licencias:licencias@localhost:5432/licencias
# En Neon o cualquier Postgres en la nube: true
DB_SSL=false
# Déjalo en false y usa las migraciones (npm run migration:run). true solo para experimentar.
DB_SYNC=false

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Seguridad ---
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
# Genera una con:  openssl rand -base64 32
LICENSE_ENC_KEY=

# --- Negocio ---
# Minutos que se reserva una licencia mientras el cliente paga (en milisegundos)
RESERVATION_TTL_MS=1800000

# --- Solo para: npm run seed ---
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-clave
